<?php

namespace App\Http\Controllers;

use App\Models\Establishment;
use App\Models\SchoolYear;
use App\Models\Student;
use App\Models\Teacher;
use App\Models\ClassRoom;
use App\Models\Subject;
use App\Models\Inscription;
use App\Models\Note;
use App\Models\Paiement;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;

class DashboardController extends Controller
{
    /**
     * Affiche le tableau de bord de l'établissement sélectionné.
     */
    public function index(Request $request)
    {
        $user = Auth::user();

        if (!$user) {
            return redirect()->route('login');
        }

        /*
        |--------------------------------------------------------------------------
        | 1. Récupération des établissements accessibles
        |--------------------------------------------------------------------------
        |
        | ADMIN :
        |   établissements dont il est propriétaire.
        |
        | SECRETAIRE / AUTRES ROLES :
        |   établissements qui lui sont affectés via establishment_user.
        |
        */
        if ($user->role === 'admin') {
            $establishments = $user
                ->establishments()
                ->with('schoolType')
                ->orderBy('id')
                ->get();
        } else {
            $establishments = $user
                ->assignedEstablishments()
                ->with('schoolType')
                ->orderBy('id')
                ->get();
        }

        /*
        |--------------------------------------------------------------------------
        | 2. Aucun établissement accessible
        |--------------------------------------------------------------------------
        */
        if ($establishments->isEmpty()) {
            session()->forget([
                'establishment_id',
                'establishment_name',
                'school_year_id',
                'school_year_name',
            ]);

            if ($user->role === 'admin') {
                return redirect()
                    ->route('establishments.create')
                    ->with('info', 'Veuillez créer votre établissement.');
            }

            return redirect()
                ->route('establishments.choose')
                ->with(
                    'error',
                    'Aucun établissement ne vous a été affecté.'
                );
        }

        /*
        |--------------------------------------------------------------------------
        | 3. Vérification de l'établissement sélectionné
        |--------------------------------------------------------------------------
        */
        $establishmentId = session('establishment_id');

        $currentEstablishment = null;

        if ($establishmentId) {
            $currentEstablishment = $establishments
                ->firstWhere('id', (int) $establishmentId);
        }

        /*
        |--------------------------------------------------------------------------
        | 4. Sélection automatique
        |--------------------------------------------------------------------------
        |
        | Si un seul établissement est accessible,
        | on le sélectionne automatiquement.
        |
        */
        if (!$currentEstablishment && $establishments->count() === 1) {
            $currentEstablishment = $establishments->first();

            session([
                'establishment_id' => $currentEstablishment->id,
                'establishment_name' => $currentEstablishment->nom,
            ]);
        }

        /*
        |--------------------------------------------------------------------------
        | 5. Plusieurs établissements mais aucun sélectionné
        |--------------------------------------------------------------------------
        */
        if (!$currentEstablishment) {
            return redirect()
                ->route('establishments.choose')
                ->with(
                    'info',
                    'Veuillez sélectionner un établissement.'
                );
        }

        /*
        |--------------------------------------------------------------------------
        | 6. Mise à jour de la session
        |--------------------------------------------------------------------------
        */
        session([
            'establishment_id' => $currentEstablishment->id,
            'establishment_name' => $currentEstablishment->nom,
        ]);

        /*
        |--------------------------------------------------------------------------
        | 7. Années scolaires de l'établissement
        |--------------------------------------------------------------------------
        */
        $schoolYears = SchoolYear::query()
            ->where('establishment_id', $currentEstablishment->id)
            ->orderByDesc('is_active')
            ->orderByDesc('start_date')
            ->orderByDesc('id')
            ->get();

        /*
        |--------------------------------------------------------------------------
        | 8. Année scolaire sélectionnée
        |--------------------------------------------------------------------------
        */
        $schoolYearId = session('school_year_id');

        $currentSchoolYear = null;

        if ($schoolYearId) {
            $currentSchoolYear = $schoolYears
                ->firstWhere('id', (int) $schoolYearId);
        }

        /*
        |--------------------------------------------------------------------------
        | 9. Sélection automatique de l'année scolaire
        |--------------------------------------------------------------------------
        */
        if (!$currentSchoolYear) {
            $currentSchoolYear = $schoolYears
                ->firstWhere('active', true);
        }

        if (!$currentSchoolYear && $schoolYears->isNotEmpty()) {
            $currentSchoolYear = $schoolYears->first();
        }

        /*
        |--------------------------------------------------------------------------
        | 10. Session année scolaire
        |--------------------------------------------------------------------------
        */
        if ($currentSchoolYear) {
            session([
                'school_year_id' => $currentSchoolYear->id,
                'school_year_name' => $currentSchoolYear->nom,
            ]);

            $schoolYearId = $currentSchoolYear->id;
        } else {
            session()->forget([
                'school_year_id',
                'school_year_name',
            ]);

            $schoolYearId = null;
        }

        /*
        |--------------------------------------------------------------------------
        | 11. Données du dashboard
        |--------------------------------------------------------------------------
        */
        $establishmentId = $currentEstablishment->id;

        /*
        |--------------------------------------------------------------------------
        | Étudiants
        |--------------------------------------------------------------------------
        */
        $studentsQuery = Student::query()
            ->where('establishment_id', $establishmentId);

        if ($schoolYearId && $this->hasColumn(Student::class, 'school_year_id')) {
            $studentsQuery->where('school_year_id', $schoolYearId);
        }

        $students = $studentsQuery
            ->orderByDesc('id')
            ->get();

        /*
        |--------------------------------------------------------------------------
        | Enseignants
        |--------------------------------------------------------------------------
        */
        $teachers = Teacher::query()
            ->where('establishment_id', $establishmentId)
            ->orderByDesc('id')
            ->get();

        /*
        |--------------------------------------------------------------------------
        | Classes
        |--------------------------------------------------------------------------
        */
        $classesQuery = ClassRoom::query()
            ->where('establishment_id', $establishmentId);

        if (
            $schoolYearId &&
            $this->hasColumn(ClassRoom::class, 'school_year_id')
        ) {
            $classesQuery->where('school_year_id', $schoolYearId);
        }

        $classes = $classesQuery
            ->orderBy('nom_classe')
            ->get();

        /*
        |--------------------------------------------------------------------------
        | Matières
        |--------------------------------------------------------------------------
        */
        $subjects = Subject::query()
            ->where('establishment_id', $establishmentId)
            ->orderBy('nom')
            ->get();

        /*
        |--------------------------------------------------------------------------
        | Inscriptions
        |--------------------------------------------------------------------------
        */
        $inscriptionsQuery = Inscription::query()
            ->where('establishment_id', $establishmentId);

        if (
            $schoolYearId &&
            $this->hasColumn(Inscription::class, 'school_year_id')
        ) {
            $inscriptionsQuery->where('school_year_id', $schoolYearId);
        }

        $inscriptions = $inscriptionsQuery
            ->orderByDesc('id')
            ->get();

        /*
        |--------------------------------------------------------------------------
        | Notes
        |--------------------------------------------------------------------------
        */
        $notesQuery = Note::query()
            ->where('establishment_id', $establishmentId);

        if (
            $schoolYearId &&
            $this->hasColumn(Note::class, 'school_year_id')
        ) {
            $notesQuery->where('school_year_id', $schoolYearId);
        }

        $notes = $notesQuery
            ->orderByDesc('id')
            ->get();

        /*
        |--------------------------------------------------------------------------
        | Paiements
        |--------------------------------------------------------------------------
        */
        $paiementsQuery = Paiement::query()
            ->where('establishment_id', $establishmentId);

        if (
            $schoolYearId &&
            $this->hasColumn(Paiement::class, 'school_year_id')
        ) {
            $paiementsQuery->where('school_year_id', $schoolYearId);
        }

        $paiements = $paiementsQuery
            ->orderByDesc('id')
            ->get();

        /*
        |--------------------------------------------------------------------------
        | Statistiques
        |--------------------------------------------------------------------------
        */
        $stats = [
            'students' => $students->count(),
            'teachers' => $teachers->count(),
            'classes' => $classes->count(),
            'subjects' => $subjects->count(),
            'inscriptions' => $inscriptions->count(),
            'notes' => $notes->count(),
            'paiements' => $paiements->count(),
            'school_years' => $schoolYears->count(),
        ];

        /*
        |--------------------------------------------------------------------------
        | Dashboard
        |--------------------------------------------------------------------------
        */
        return view('dashboard', [
            'user' => $user,

            'establishments' => $establishments,
            'currentEstablishment' => $currentEstablishment,

            'schoolYears' => $schoolYears,
            'currentSchoolYear' => $currentSchoolYear,

            'students' => $students,
            'teachers' => $teachers,
            'classes' => $classes,
            'subjects' => $subjects,
            'inscriptions' => $inscriptions,
            'notes' => $notes,
            'paiements' => $paiements,

            'stats' => $stats,
        ]);
    }

    /**
     * Vérifie si la table liée au modèle possède une colonne donnée.
     *
     * Cette méthode évite de casser le dashboard si certains modèles
     * n'ont pas encore la colonne school_year_id.
     */
    private function hasColumn(string $modelClass, string $column): bool
    {
        try {
            $model = new $modelClass();

            return \Schema::hasColumn(
                $model->getTable(),
                $column
            );
        } catch (\Throwable $e) {
            return false;
        }
    }
}
