    /**
     * Met à jour une classe.
     */
    public function update(
        Request $request,
        ClassRoom $classRoom
    ): RedirectResponse {
        $establishmentId =
            session('establishment_id');

        abort_unless(
            $establishmentId,
            403
        );

        abort_unless(
            (int) $classRoom->establishment_id
                === (int) $establishmentId,
            403
        );

        $validated = $request->validate([
            'nom_classe' => [
                'required',
                'string',
                'max:255',
            ],

            'niveau' => [
                'nullable',
                'string',
                'max:255',
            ],

            'filiere' => [
                'nullable',
                'string',
                'max:255',
            ],

            'school_year_id' => [
                'nullable',
                'integer',
                'exists:school_years,id',
            ],

            'teacher_id' => [
                'nullable',
                'integer',
                'exists:teachers,id',
            ],

            'salle_id' => [
                'nullable',
                'integer',
                'exists:salles,id',
            ],

            'annee_scolaire' => [
                'nullable',
                'string',
                'max:255',
            ],

            'salle' => [
                'nullable',
                'string',
                'max:255',
            ],

            'capacite' => [
                'nullable',
                'integer',
                'min:0',
            ],

            'effectif_minimum' => [
                'nullable',
                'integer',
                'min:0',
            ],

            'effectif_maximum' => [
                'nullable',
                'integer',
                'min:0',
            ],
        ]);

        /*
        |--------------------------------------------------------------------------
        | Établissement + type
        |--------------------------------------------------------------------------
        */

        $establishment = Establishment::query()
            ->with('schoolType')
            ->findOrFail(
                $establishmentId
            );

        $typeName =
            $this->getTypeName(
                $establishment
            );

        $niveauxAutorises =
            $this->getNiveauxForType(
                $typeName
            );

        /*
        |--------------------------------------------------------------------------
        | Niveau
        |--------------------------------------------------------------------------
        */

        $niveau = trim(
            (string) ($validated['niveau'] ?? '')
        );

        if (
            $niveau !== ''
            && !empty($niveauxAutorises)
            && !in_array(
                $niveau,
                $niveauxAutorises,
                true
            )
        ) {
            return back()
                ->withInput()
                ->withErrors([
                    'niveau' =>
                        'Le niveau sélectionné n’est pas valide pour ce type d’établissement.',
                ]);
        }

        /*
        |--------------------------------------------------------------------------
        | Filière universitaire
        |--------------------------------------------------------------------------
        */

        $isUniversity = in_array(
            $typeName,
            ['université', 'universite'],
            true
        );

        $filiere = trim(
            (string) ($validated['filiere'] ?? '')
        );

        if (
            $isUniversity
            && $filiere === ''
        ) {
            return back()
                ->withInput()
                ->withErrors([
                    'filiere' =>
                        'La filière est obligatoire pour une classe universitaire.',
                ]);
        }

        /*
        |--------------------------------------------------------------------------
        | Année scolaire
        |--------------------------------------------------------------------------
        */

        if (!empty($validated['school_year_id'])) {
            $schoolYear = SchoolYear::query()
                ->where(
                    'id',
                    $validated['school_year_id']
                )
                ->where(
                    'establishment_id',
                    $establishmentId
                )
                ->first();

            abort_unless(
                $schoolYear,
                403
            );

            if (
                empty(
                    $validated['annee_scolaire']
                )
            ) {
                $validated['annee_scolaire'] =
                    $schoolYear->name
                    ?? $schoolYear->nom
                    ?? $schoolYear->annee_scolaire
                    ?? $schoolYear->libelle
                    ?? null;
            }
        }

        /*
        |--------------------------------------------------------------------------
        | Enseignant
        |--------------------------------------------------------------------------
        */

        if (!empty($validated['teacher_id'])) {
            $teacherBelongsToEstablishment =
                Teacher::query()
                    ->where(
                        'id',
                        $validated['teacher_id']
                    )
                    ->where(
                        'establishment_id',
                        $establishmentId
                    )
                    ->exists();

            abort_unless(
                $teacherBelongsToEstablishment,
                403
            );
        }

        /*
        |--------------------------------------------------------------------------
        | Salle
        |--------------------------------------------------------------------------
        */

        if (!empty($validated['salle_id'])) {
            $salle = Salle::query()
                ->where(
                    'id',
                    $validated['salle_id']
                )
                ->where(
                    'establishment_id',
                    $establishmentId
                )
                ->first();

            abort_unless(
                $salle,
                403
            );

            $validated['salle'] =
                $salle->nom;
        } else {
            $validated['salle'] = null;
        }

        /*
        |--------------------------------------------------------------------------
        | Minimum / maximum
        |--------------------------------------------------------------------------
        */

        if (
            isset($validated['effectif_minimum'])
            && isset($validated['effectif_maximum'])
            && $validated['effectif_minimum']
                > $validated['effectif_maximum']
        ) {
            return back()
                ->withInput()
                ->withErrors([
                    'effectif_maximum' =>
                        'L’effectif maximum doit être supérieur ou égal à l’effectif minimum.',
                ]);
        }

        /*
        |--------------------------------------------------------------------------
        | Capacité
        |--------------------------------------------------------------------------
        */

        if (
            !isset($validated['capacite'])
            && isset($validated['effectif_maximum'])
        ) {
            $validated['capacite'] =
                $validated['effectif_maximum'];
        }

        if (
            isset($validated['capacite'])
            && isset($validated['effectif_maximum'])
            && $validated['capacite']
                < $validated['effectif_maximum']
        ) {
            return back()
                ->withInput()
                ->withErrors([
                    'capacite' =>
                        'La capacité doit être supérieure ou égale à l’effectif maximum.',
                ]);
        }

        /*
        |--------------------------------------------------------------------------
        | Anti-doublon lors de la modification
        |--------------------------------------------------------------------------
        */

        $schoolYearId =
            $validated['school_year_id']
            ?? $classRoom->school_year_id;

        $nomClasse = trim(
            (string) $validated['nom_classe']
        );

        $duplicateExists = ClassRoom::query()
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->where(
                'school_year_id',
                $schoolYearId
            )
            ->whereRaw(
                'LOWER(TRIM(nom_classe)) = ?',
                [
                    mb_strtolower(
                        $nomClasse
                    ),
                ]
            )
            ->where(
                'id',
                '!=',
                $classRoom->id
            )
            ->exists();

        if ($duplicateExists) {
            return back()
                ->withInput()
                ->withErrors([
                    'nom_classe' =>
                        'La classe « ' .
                        $nomClasse .
                        ' » existe déjà pour cette année scolaire.',
                ]);
        }

        /*
        |--------------------------------------------------------------------------
        | Mise à jour
        |--------------------------------------------------------------------------
        */

        $classRoom->update(
            $validated
        );

        return redirect()
            ->route(
                'class_rooms.show',
                $classRoom
            )
            ->with(
                'success',
                'La classe a été modifiée avec succès.'
            );
    }

    /**
     * Supprime une classe.
     */
    public function destroy(
        ClassRoom $classRoom
    ): RedirectResponse {
        $establishmentId =
            session('establishment_id');

        abort_unless(
            $establishmentId,
            403
        );

        abort_unless(
            (int) $classRoom->establishment_id
                === (int) $establishmentId,
            403
        );

        $classRoom->delete();

        return redirect()
            ->route('class_rooms.index')
            ->with(
                'success',
                'La classe a été supprimée avec succès.'
            );
    }

    /**
     * Retourne le nom normalisé du type d'établissement.
     */
    private function getTypeName(
        Establishment $establishment
    ): string {
        return strtolower(
            trim(
                (string) (
                    $establishment
                        ->schoolType
                        ?->name
                    ?? $establishment
                        ->schoolType
                        ?->nom
                    ?? ''
                )
            )
        );
    }

    /**
     * Retourne les niveaux autorisés selon le type.
     */
    private function getNiveauxForType(
        string $typeName
    ): array {
        return match ($typeName) {
            'primaire' => [
                'CP1',
                'CP2',
                'CE1',
                'CE2',
                'CM1',
                'CM2',
            ],

            'collège',
            'college' => [
                '6ème',
                '5ème',
                '4ème',
                '3ème',
            ],

            'lycée',
            'lycee' => [
                'Seconde',
                'Première',
                'Terminale',
            ],

            'université',
            'universite' => [
                'L1',
                'L2',
                'L3',
                'M1',
                'M2',
                'Doctorat',
            ],

            default => [],
        };
    }
