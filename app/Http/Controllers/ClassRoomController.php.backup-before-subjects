<?php

namespace App\Http\Controllers;

use App\Models\ClassRoom;
use App\Models\Establishment;
use App\Models\Salle;
use App\Models\SchoolYear;
use App\Models\Subject;
use App\Models\Teacher;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\View\View;

class ClassRoomController extends Controller
{
    /**
     * Liste des classes de l'établissement actuellement sélectionné.
     */
    public function index(Request $request): View
    {
        $establishmentId = session('establishment_id');

        abort_unless($establishmentId, 403);

        $search = trim((string) $request->input('search'));
        $schoolYearId = $request->input('school_year_id');

        $establishment = Establishment::query()
            ->with('schoolType')
            ->findOrFail($establishmentId);

        $schoolYears = SchoolYear::query()
            ->where('establishment_id', $establishmentId)
            ->orderByDesc('is_active')
            ->orderByDesc('start_date')
            ->get();

        $classRoomsQuery = ClassRoom::query()
            ->where('establishment_id', $establishmentId)
            ->with([
                'teacher',
                'room',
                'schoolYear',
            ])
            ->withCount([
                'inscriptions as effectif_actuel' => function ($query) {
                    $query->where('statut', 'Actif');
                },
                'subjects as subjects_count',
            ]);

        if ($schoolYearId !== null && $schoolYearId !== '') {
            $classRoomsQuery->where('school_year_id', $schoolYearId);
        }

        if ($search !== '') {
            $classRoomsQuery->where(function ($query) use ($search) {
                $query
                    ->where('nom_classe', 'like', '%' . $search . '%')
                    ->orWhere('niveau', 'like', '%' . $search . '%')
                    ->orWhere('filiere', 'like', '%' . $search . '%')
                    ->orWhere('salle', 'like', '%' . $search . '%');
            });
        }

        $classRooms = $classRoomsQuery
            ->orderBy('niveau')
            ->orderBy('nom_classe')
            ->get();

        return view('classes.index', [
            'establishment' => $establishment,
            'schoolYears' => $schoolYears,
            'classes' => $classRooms,
            'search' => $search,
            'schoolYearId' => $schoolYearId,
        ]);
    }

    /**
     * Formulaire de création des classes.
     */
    public function create(): View
    {
        $establishmentId = session('establishment_id');

        abort_unless($establishmentId, 403);

        $establishment = Establishment::query()
            ->with('schoolType')
            ->findOrFail($establishmentId);

        $typeName = $this->getTypeName($establishment);

        $niveaux = $this->getNiveauxForType($typeName);

        $schoolYears = SchoolYear::query()
            ->where('establishment_id', $establishmentId)
            ->orderByDesc('is_active')
            ->orderByDesc('start_date')
            ->get();

        $teachers = Teacher::query()
            ->where('establishment_id', $establishmentId)
            ->orderBy('nom')
            ->orderBy('prenom')
            ->get();

        $salles = Salle::query()
            ->where('establishment_id', $establishmentId)
            ->orderBy('nom')
            ->get();

        $subjects = Subject::query()
            ->where('establishment_id', $establishmentId)
            ->orderBy('nom')
            ->get();

        return view('classes.create', [
            'establishment' => $establishment,
            'typeName' => $typeName,
            'niveaux' => $niveaux,
            'schoolYears' => $schoolYears,
            'teachers' => $teachers,
            'salles' => $salles,
            'subjects' => $subjects,
        ]);
    }

    /**
     * Enregistre une ou plusieurs classes.
     */
    public function store(Request $request): RedirectResponse
    {
        $establishmentId = session('establishment_id');

        abort_unless($establishmentId, 403);

        $validated = $request->validate([
            'school_year_id' => [
                'required',
                'integer',
                'exists:school_years,id',
            ],

            'annee_scolaire' => [
                'nullable',
                'string',
                'max:255',
            ],

            'classes' => [
                'required',
                'array',
                'min:1',
            ],

            'classes.*.niveau' => [
                'required',
                'string',
                'max:255',
            ],

            'classes.*.nom' => [
                'required',
                'string',
                'max:150',
            ],

            'classes.*.filiere' => [
                'nullable',
                'string',
                'max:150',
            ],

            'classes.*.teacher_id' => [
                'nullable',
                'integer',
                'exists:teachers,id',
            ],

            'classes.*.salle_id' => [
                'nullable',
                'integer',
                'exists:salles,id',
            ],

            'classes.*.capacite' => [
                'nullable',
                'integer',
                'min:1',
                'max:10000',
            ],

            'classes.*.effectif_minimum' => [
                'nullable',
                'integer',
                'min:0',
                'max:10000',
            ],

            'classes.*.effectif_maximum' => [
                'nullable',
                'integer',
                'min:1',
                'max:10000',
            ],
        ]);

        /*
        |--------------------------------------------------------------------------
        | Vérification de l'année scolaire
        |--------------------------------------------------------------------------
        */

        $schoolYear = SchoolYear::query()
            ->where('id', $validated['school_year_id'])
            ->where('establishment_id', $establishmentId)
            ->first();

        abort_unless($schoolYear, 403);

        /*
        |--------------------------------------------------------------------------
        | Année scolaire affichée
        |--------------------------------------------------------------------------
        */

        $anneeScolaire = trim(
            (string) ($validated['annee_scolaire'] ?? '')
        );

        if ($anneeScolaire === '') {
            $anneeScolaire =
                $schoolYear->name
                ?? $schoolYear->nom
                ?? $schoolYear->annee_scolaire
                ?? $schoolYear->libelle
                ?? '';
        }

        /*
        |--------------------------------------------------------------------------
        | Établissement + type
        |--------------------------------------------------------------------------
        */

        $establishment = Establishment::query()
            ->with('schoolType')
            ->findOrFail($establishmentId);

        $typeName = $this->getTypeName($establishment);

        $niveauxAutorises = $this->getNiveauxForType($typeName);

        /*
        |--------------------------------------------------------------------------
        | Anti-doublon dans le formulaire
        |--------------------------------------------------------------------------
        */

        $currentClassNames = [];

        /*
        |--------------------------------------------------------------------------
        | Validation métier
        |--------------------------------------------------------------------------
        */

        foreach ($validated['classes'] as $index => $classe) {
            $niveau = trim((string) $classe['niveau']);
            $nom = trim((string) $classe['nom']);
            $filiere = trim((string) ($classe['filiere'] ?? ''));

            /*
            |--------------------------------------------------------------------------
            | Niveau autorisé selon le type d'établissement
            |--------------------------------------------------------------------------
            */

            if (
                !empty($niveauxAutorises)
                && !in_array($niveau, $niveauxAutorises, true)
            ) {
                return back()
                    ->withInput()
                    ->withErrors([
                        "classes.$index.niveau" =>
                            'Le niveau sélectionné n’est pas valide pour ce type d’établissement.',
                    ]);
            }

            /*
            |--------------------------------------------------------------------------
            | Filière obligatoire à l'Université
            |--------------------------------------------------------------------------
            */

            $isUniversity = in_array(
                $typeName,
                ['université', 'universite'],
                true
            );

            if (
                $isUniversity
                && $filiere === ''
            ) {
                return back()
                    ->withInput()
                    ->withErrors([
                        "classes.$index.filiere" =>
                            'La filière est obligatoire pour une classe universitaire.',
                    ]);
            }

            /*
            |--------------------------------------------------------------------------
            | Construction du nom final
            |--------------------------------------------------------------------------
            */

            if ($isUniversity) {
                $nomClasse = implode(' - ', array_filter([
                    $niveau,
                    $filiere,
                    $nom,
                ]));
            } else {
                $nomClasse = trim(
                    $niveau . ' ' . $nom
                );
            }

            $normalizedName = mb_strtolower(
                trim($nomClasse)
            );

            /*
            |--------------------------------------------------------------------------
            | Doublon dans le même formulaire
            |--------------------------------------------------------------------------
            */

            if (
                in_array(
                    $normalizedName,
                    $currentClassNames,
                    true
                )
            ) {
                return back()
                    ->withInput()
                    ->withErrors([
                        "classes.$index.nom" =>
                            'La classe « ' . $nomClasse .
                            ' » est présente plusieurs fois dans ce formulaire.',
                    ]);
            }

            $currentClassNames[] = $normalizedName;

            /*
            |--------------------------------------------------------------------------
            | Doublon déjà présent en base
            |--------------------------------------------------------------------------
            */

            $duplicateExists = ClassRoom::query()
                ->where('establishment_id', $establishmentId)
                ->where(
                    'school_year_id',
                    $validated['school_year_id']
                )
                ->whereRaw(
                    'LOWER(TRIM(nom_classe)) = ?',
                    [$normalizedName]
                )
                ->exists();

            if ($duplicateExists) {
                return back()
                    ->withInput()
                    ->withErrors([
                        "classes.$index.nom" =>
                            'La classe « ' . $nomClasse .
                            ' » existe déjà pour cette année scolaire.',
                    ]);
            }

            /*
            |--------------------------------------------------------------------------
            | Vérification enseignant
            |--------------------------------------------------------------------------
            */

            if (!empty($classe['teacher_id'])) {
                $teacherBelongsToEstablishment = Teacher::query()
                    ->where('id', $classe['teacher_id'])
                    ->where(
                        'establishment_id',
                        $establishmentId
                    )
                    ->exists();

                abort_unless(
                    $teacherBelongsToEstablishment,
                    403
                );
            }

            /*
            |--------------------------------------------------------------------------
            | Vérification salle
            |--------------------------------------------------------------------------
            */

            if (!empty($classe['salle_id'])) {
                $salleBelongsToEstablishment = Salle::query()
                    ->where('id', $classe['salle_id'])
                    ->where(
                        'establishment_id',
                        $establishmentId
                    )
                    ->exists();

                abort_unless(
                    $salleBelongsToEstablishment,
                    403
                );
            }

            /*
            |--------------------------------------------------------------------------
            | Vérification minimum / maximum
            |--------------------------------------------------------------------------
            */

            if (
                isset($classe['effectif_minimum'])
                && isset($classe['effectif_maximum'])
                && $classe['effectif_minimum']
                    > $classe['effectif_maximum']
            ) {
                return back()
                    ->withInput()
                    ->withErrors([
                        "classes.$index.effectif_maximum" =>
                            'L’effectif maximum doit être supérieur ou égal à l’effectif minimum.',
                    ]);
            }

            /*
            |--------------------------------------------------------------------------
            | Vérification capacité / maximum
            |--------------------------------------------------------------------------
            */

            if (
                isset($classe['capacite'])
                && isset($classe['effectif_maximum'])
                && $classe['capacite']
                    < $classe['effectif_maximum']
            ) {
                return back()
                    ->withInput()
                    ->withErrors([
                        "classes.$index.capacite" =>
                            'La capacité doit être supérieure ou égale à l’effectif maximum.',
                    ]);
            }
        }

        /*
        |--------------------------------------------------------------------------
        | Création transactionnelle
        |--------------------------------------------------------------------------
        */

        DB::transaction(function () use (
            $validated,
            $establishmentId,
            $anneeScolaire,
            $typeName
        ) {
            foreach ($validated['classes'] as $classe) {
                $niveau = trim(
                    (string) $classe['niveau']
                );

                $nom = trim(
                    (string) $classe['nom']
                );

                $filiere = trim(
                    (string) ($classe['filiere'] ?? '')
                );

                $isUniversity = in_array(
                    $typeName,
                    ['université', 'universite'],
                    true
                );

                /*
                |--------------------------------------------------------------------------
                | Nom final
                |--------------------------------------------------------------------------
                */

                if ($isUniversity) {
                    $nomClasse = implode(' - ', array_filter([
                        $niveau,
                        $filiere,
                        $nom,
                    ]));
                } else {
                    $nomClasse = trim(
                        $niveau . ' ' . $nom
                    );
                }

                /*
                |--------------------------------------------------------------------------
                | Capacité
                |--------------------------------------------------------------------------
                */

                $capacite =
                    $classe['capacite']
                    ?? null;

                $effectifMinimum =
                    $classe['effectif_minimum']
                    ?? null;

                $effectifMaximum =
                    $classe['effectif_maximum']
                    ?? null;

                if (
                    $capacite === null
                    && $effectifMaximum !== null
                ) {
                    $capacite = $effectifMaximum;
                }

                /*
                |--------------------------------------------------------------------------
                | Salle
                |--------------------------------------------------------------------------
                */

                $salleNom = null;

                if (!empty($classe['salle_id'])) {
                    $salle = Salle::query()
                        ->where(
                            'id',
                            $classe['salle_id']
                        )
                        ->where(
                            'establishment_id',
                            $establishmentId
                        )
                        ->first();

                    if ($salle) {
                        $salleNom = $salle->nom;
                    }
                }

                /*
                |--------------------------------------------------------------------------
                | Création
                |--------------------------------------------------------------------------
                */

                ClassRoom::create([
                    'establishment_id' =>
                        $establishmentId,

                    'nom_classe' =>
                        $nomClasse,

                    'niveau' =>
                        $niveau,

                    'filiere' =>
                        $filiere !== ''
                            ? $filiere
                            : null,

                    'school_year_id' =>
                        $validated['school_year_id'],

                    'teacher_id' =>
                        $classe['teacher_id']
                        ?? null,

                    'salle_id' =>
                        $classe['salle_id']
                        ?? null,

                    'annee_scolaire' =>
                        $anneeScolaire !== ''
                            ? $anneeScolaire
                            : null,

                    'salle' =>
                        $salleNom,

                    'capacite' =>
                        $capacite,

                    'effectif_minimum' =>
                        $effectifMinimum,

                    'effectif_maximum' =>
                        $effectifMaximum,
                ]);
            }
        });

        $nombreClasses = count(
            $validated['classes']
        );

        return redirect()
            ->route('class_rooms.index')
            ->with(
                'success',
                $nombreClasses .
                ' classe(s) créée(s) avec succès.'
            );
    }

    /**
     * Affiche une classe et ses étudiants.
     */
    public function show(
        ClassRoom $classRoom
    ): View {
        $establishmentId =
            session('establishment_id');

        abort_unless(
            $establishmentId,
            403
        );

        abort_unless(
            (int) $classRoom->establishment_id
                === (int) $establishmentId,
            403
        );

        $classRoom->load([
            'establishment.schoolType',
            'teacher',
            'salle',
            'schoolYear',
            'subjects',
        ]);

        $students = $classRoom
            ->inscriptions()
            ->with('student')
            ->where('statut', 'Actif')
            ->get()
            ->map(function ($inscription) {
                return $inscription->student;
            })
            ->filter();

        return view(
            'classes.show',
            [
                'classRoom' => $classRoom,
                'students' => $students,
            ]
        );
    }

