<?php

namespace App\Http\Controllers;

use App\Models\ClassRoom;
use App\Models\SchoolYear;
use App\Models\Subject;
use App\Models\Teacher;
use App\Models\TeacherSubject;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Validation\Rule;

class TeacherSubjectController extends Controller
{
    /**
     * Vérifie que l'utilisateur est administrateur.
     */
    private function ensureAdmin(): void
    {
        abort_unless(
            Auth::check() && Auth::user()->role === 'admin',
            403,
            'Accès réservé aux administrateurs.'
        );
    }

    /**
     * Récupère l'identifiant de l'établissement courant.
     */
    private function establishmentId(): int
    {
        return (int) session('establishment_id');
    }

    /**
     * Vérifie qu'un établissement est sélectionné.
     */
    private function checkEstablishment(): void
    {
        if (!$this->establishmentId()) {
            abort(
                403,
                'Aucun établissement sélectionné.'
            );
        }
    }

    /**
     * Récupère l'année scolaire sélectionnée.
     *
     * Si l'année en session n'appartient pas à l'établissement,
     * on utilise l'année active.
     */
    private function activeSchoolYear(): ?SchoolYear
    {
        $establishmentId = $this->establishmentId();

        $schoolYearId = session('school_year_id');

        if ($schoolYearId) {
            $schoolYear = SchoolYear::query()
                ->where('id', $schoolYearId)
                ->where(
                    'establishment_id',
                    $establishmentId
                )
                ->first();

            if ($schoolYear) {
                return $schoolYear;
            }
        }

        return SchoolYear::query()
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->where('is_active', true)
            ->orderByDesc('start_date')
            ->first();
    }

    /**
     * Liste des affectations.
     */
    public function index()
    {
        $this->ensureAdmin();
        $this->checkEstablishment();

        $establishmentId = $this->establishmentId();

        $assignments = TeacherSubject::query()
            ->with([
                'teacher',
                'subject',
                'classRoom',
                'schoolYear',
            ])
            ->whereHas(
                'teacher',
                function ($query) use ($establishmentId) {
                    $query->where(
                        'establishment_id',
                        $establishmentId
                    );
                }
            )
            ->whereHas(
                'subject',
                function ($query) use ($establishmentId) {
                    $query->where(
                        'establishment_id',
                        $establishmentId
                    );
                }
            )
            ->whereHas(
                'classRoom',
                function ($query) use ($establishmentId) {
                    $query->where(
                        'establishment_id',
                        $establishmentId
                    );
                }
            )
            ->whereHas(
                'schoolYear',
                function ($query) use ($establishmentId) {
                    $query->where(
                        'establishment_id',
                        $establishmentId
                    );
                }
            )
            ->orderByDesc('school_year_id')
            ->orderBy('teacher_id')
            ->orderBy('class_room_id')
            ->get();

        return view(
            'teacher_subjects.index',
            compact('assignments')
        );
    }

    /**
     * Formulaire d'une nouvelle affectation.
     */
    public function create()
    {
        $this->ensureAdmin();
        $this->checkEstablishment();

        $establishmentId = $this->establishmentId();

        /*
         * Années scolaires de l'établissement.
         */
        $schoolYears = SchoolYear::query()
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->orderByDesc('is_active')
            ->orderByDesc('start_date')
            ->get();

        /*
         * Année sélectionnée ou active.
         */
        $activeSchoolYear = $this->activeSchoolYear();

        /*
         * Enseignants de l'établissement.
         */
        $teachers = Teacher::query()
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->orderBy('nom')
            ->orderBy('prenom')
            ->get();

        $subjects = collect();
        $classRooms = collect();

        if ($activeSchoolYear) {

            /*
             * Matières de l'établissement
             * pour l'année courante.
             */
            $subjects = Subject::query()
                ->where(
                    'establishment_id',
                    $establishmentId
                )
                ->where(
                    'school_year_id',
                    $activeSchoolYear->id
                )
                ->orderBy('nom')
                ->get();

            /*
             * Classes de l'établissement
             * pour l'année courante.
             */
            $classRooms = ClassRoom::query()
                ->where(
                    'establishment_id',
                    $establishmentId
                )
                ->where(
                    'school_year_id',
                    $activeSchoolYear->id
                )
                ->orderBy('niveau')
                ->orderBy('nom_classe')
                ->get();
        }

        return view(
            'teacher_subjects.create',
            compact(
                'teachers',
                'subjects',
                'classRooms',
                'schoolYears',
                'activeSchoolYear'
            )
        );
    }

    /**
     * Enregistre une nouvelle affectation.
     */
    public function store(Request $request)
    {
        $this->ensureAdmin();
        $this->checkEstablishment();

        $establishmentId = $this->establishmentId();

        /*
         * Validation de base.
         */
        $validated = $request->validate([
            'teacher_id' => [
                'required',
                'integer',
                Rule::exists('teachers', 'id')
                    ->where(
                        fn ($query) =>
                            $query->where(
                                'establishment_id',
                                $establishmentId
                            )
                    ),
            ],

            'subject_id' => [
                'required',
                'integer',
            ],

            'class_room_id' => [
                'required',
                'integer',
            ],

            'school_year_id' => [
                'required',
                'integer',
                Rule::exists('school_years', 'id')
                    ->where(
                        fn ($query) =>
                            $query->where(
                                'establishment_id',
                                $establishmentId
                            )
                    ),
            ],
        ]);

        /*
         * Vérifie l'année scolaire.
         */
        $schoolYear = SchoolYear::query()
            ->where(
                'id',
                $validated['school_year_id']
            )
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->first();

        if (!$schoolYear) {
            return back()
                ->withInput()
                ->withErrors([
                    'school_year_id' =>
                        'L’année scolaire sélectionnée est invalide.',
                ]);
        }

        /*
         * Vérifie l'enseignant.
         */
        $teacher = Teacher::query()
            ->where(
                'id',
                $validated['teacher_id']
            )
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->first();

        if (!$teacher) {
            return back()
                ->withInput()
                ->withErrors([
                    'teacher_id' =>
                        'L’enseignant sélectionné n’appartient pas à cet établissement.',
                ]);
        }

        /*
         * Vérifie la classe.
         */
        $classRoom = ClassRoom::query()
            ->where(
                'id',
                $validated['class_room_id']
            )
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->first();

        if (!$classRoom) {
            return back()
                ->withInput()
                ->withErrors([
                    'class_room_id' =>
                        'La classe sélectionnée n’appartient pas à cet établissement.',
                ]);
        }

        /*
         * La classe doit appartenir à l'année sélectionnée.
         */
        if (
            (int) $classRoom->school_year_id !==
            (int) $schoolYear->id
        ) {
            return back()
                ->withInput()
                ->withErrors([
                    'class_room_id' =>
                        'Cette classe n’appartient pas à l’année scolaire sélectionnée.',
                ]);
        }

        /*
         * Vérifie la matière.
         */
        $subject = Subject::query()
            ->where(
                'id',
                $validated['subject_id']
            )
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->where(
                'school_year_id',
                $schoolYear->id
            )
            ->first();

        if (!$subject) {
            return back()
                ->withInput()
                ->withErrors([
                    'subject_id' =>
                        'Cette matière n’appartient pas à l’année scolaire sélectionnée.',
                ]);
        }

        /*
         * Vérifie le type d'établissement
         * lorsque cette information existe.
         */
        if (
            $subject->school_type_id &&
            $teacher->establishment &&
            (int) $subject->school_type_id !==
            (int) $teacher->establishment->school_type_id
        ) {
            return back()
                ->withInput()
                ->withErrors([
                    'subject_id' =>
                        'Cette matière ne correspond pas au type de l’établissement.',
                ]);
        }

        /*
         * Vérifie qu'il n'existe pas déjà
         * la même affectation.
         */
        $alreadyExists = TeacherSubject::query()
            ->where(
                'teacher_id',
                $teacher->id
            )
            ->where(
                'subject_id',
                $subject->id
            )
            ->where(
                'class_room_id',
                $classRoom->id
            )
            ->where(
                'school_year_id',
                $schoolYear->id
            )
            ->exists();

        if ($alreadyExists) {
            return back()
                ->withInput()
                ->withErrors([
                    'teacher_id' =>
                        'Cette affectation existe déjà pour cet enseignant, cette matière, cette classe et cette année scolaire.',
                ]);
        }

        /*
         * Création de l'affectation.
         */
        TeacherSubject::create([
            'teacher_id' => $teacher->id,
            'subject_id' => $subject->id,
            'class_room_id' => $classRoom->id,
            'school_year_id' => $schoolYear->id,
        ]);

        return redirect()
            ->route('teacher_subjects.index')
            ->with(
                'success',
                'Enseignant affecté avec succès.'
            );
    }

    /**
     * Supprime une affectation.
     */
    public function destroy(
        TeacherSubject $teacherSubject
    ) {
        $this->ensureAdmin();
        $this->checkEstablishment();

        $establishmentId = $this->establishmentId();

        /*
         * Vérifie que l'enseignant appartient
         * à l'établissement courant.
         */
        $authorizedTeacher = Teacher::query()
            ->where(
                'id',
                $teacherSubject->teacher_id
            )
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->exists();

        /*
         * Vérifie que la matière appartient
         * à l'établissement courant.
         */
        $authorizedSubject = Subject::query()
            ->where(
                'id',
                $teacherSubject->subject_id
            )
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->exists();

        /*
         * Vérifie que la classe appartient
         * à l'établissement courant.
         */
        $authorizedClass = ClassRoom::query()
            ->where(
                'id',
                $teacherSubject->class_room_id
            )
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->exists();

        /*
         * Vérifie que l'année scolaire appartient
         * à l'établissement courant.
         */
        $authorizedYear = SchoolYear::query()
            ->where(
                'id',
                $teacherSubject->school_year_id
            )
            ->where(
                'establishment_id',
                $establishmentId
            )
            ->exists();

        abort_unless(
            $authorizedTeacher &&
            $authorizedSubject &&
            $authorizedClass &&
            $authorizedYear,
            403,
            'Cette affectation n’appartient pas à votre établissement.'
        );

        $teacherSubject->delete();

        return redirect()
            ->route('teacher_subjects.index')
            ->with(
                'success',
                'Affectation supprimée avec succès.'
            );
    }
}
