<script>
document.addEventListener('DOMContentLoaded', function () {

    const niveau = document.getElementById('niveau');
    const filiere = document.getElementById('filiere');
    const preview = document.getElementById('class-preview');

    function updatePreview() {

        if (!niveau || !preview) {
            return;
        }

        const niveauValue = niveau.value.trim();

        if (!niveauValue) {
            preview.textContent = 'Sélectionnez un niveau';
            return;
        }

        @if ($typeName === 'université')

            const filiereValue = filiere
                ? filiere.value.trim()
                : '';

            if (filiereValue) {
                preview.textContent =
                    niveauValue + ' - ' + filiereValue;
            } else {
                preview.textContent =
                    niveauValue + ' - Filière';
            }

        @else

            preview.textContent = niveauValue;

        @endif
    }

    if (niveau) {
        niveau.addEventListener(
            'change',
            updatePreview
        );
    }

    if (filiere) {
        filiere.addEventListener(
            'input',
            updatePreview
        );
    }

    updatePreview();

});
</script>

@endpush

